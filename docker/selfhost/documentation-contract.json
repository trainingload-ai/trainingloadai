  "releaseCandidateScenarios": [
    {
      "id": "verify-release-candidate",
      "document": "docs/self-hosting/release-candidate.zh.md",
      "argv": [
        "--candidate-directory",
        "<downloaded-candidate-directory>",
        "--release-version",
        "1.1.16",
        "--release-revision",
        "0123456789abcdef0123456789abcdef01234567",
        "--json"
      ],
      "requiredTokens": [
        "selfhost:release-candidate-verify",
        "--candidate-directory",
        "--release-version",
        "--release-revision",
        "--json"
      ]
    }
  ],
  "attestationScenarios": [
    {
      "id": "prepare-release-attestation",
      "document": "docs/self-hosting/release-candidate.zh.md",
      "argv": [
        "--attestation-file",
        "release-attestation.json",
        "--release-version",
        "1.1.16",
        "--release-revision",
        "0123456789abcdef0123456789abcdef01234567",
        "--release-archive-sha256",
        "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        "--json"
      ],
      "requiredTokens": [
        "selfhost:release-attestation-prepare",
        "--attestation-file",
        "--release-version",
