{
  "name": "@trainingloadai/database",
  "version": "1.1.16",
  "private": true,
  "exports": {
    "./core-migration-runner": {
      "types": "./core/runner/core-migration-runner.d.ts",
      "import": "./core/runner/core-migration-runner.mjs"
    }
  },
  "scripts": {
    "db:generate": "prisma generate --schema core/schema.prisma",
    "core:migrate": "node core/runner/core-migration-runner.mjs",
    "core:migrate:test": "node --test core/runner/core-migration-runner.test.mjs",
    "core:migrate:test:postgres": "node --test core/runner/core-migration-runner.postgres.test.mjs"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@prisma/client": "6.19.3",
    "prisma": "6.19.3",
    "ts-node": "^10.9.1",
    "typescript": "5.9.3"
  },
  "license": "AGPL-3.0-only"
}
