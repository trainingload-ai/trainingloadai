  role   PlanWorkoutActivityLinkRole   @default(PRIMARY)

  linkedAt   DateTime  @default(now()) @map("linked_at")
  unlinkedAt DateTime? @map("unlinked_at")

  // 该 link 创建时是否把 workout.status 由 PLANNED/IN_PROGRESS 推到 DONE。
  // 解绑时若为 true 则把 workout.status 回退到 PLANNED；用户手动改成 DONE 的不动。
  autoMarkedWorkoutDone Boolean @default(false) @map("auto_marked_workout_done")

  @@index([planId, planWorkoutId])
  @@index([planWorkoutId, unlinkedAt])
  @@index([activityId, unlinkedAt])
  @@map("t_plan_workout_activity_link")
}

