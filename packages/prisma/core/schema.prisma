model UserZoneSetting {
  id        Int         @id @default(autoincrement())
  userId    String      @map("user_id")
  user      T_user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sportType SportType   @map("sport_type")
  zoneType  ZoneType    @map("zone_type")
  // 根据 benchmark 是否是 CUSTOM 来判断是否是基于百分比
  benchmark ZoneBase?   @map("zone_base")
  // Array of zones.
  // Structure: [{ "min": number, "max": number, "name": string, "color"?: string, "order": number }]
  zones     UserZones[]

  // 当前区间配置的写入来源。source 保留业务语义，originProvider 表示真实第三方来源。
  changeSource     ChangeSource?       @map("change_source")
  originProvider   ThirdPartyProvider? @map("origin_provider")
  originExternalId String?             @map("origin_external_id")
  originChecksum   String?             @map("origin_checksum")
  originSyncedAt   DateTime?           @map("origin_synced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, sportType, zoneType])
  @@index([userId])
  @@index([originProvider, originExternalId])
  @@map("t_user_zone_setting")
}

model UserZones {
  id                Int     @id @default(autoincrement())
  userZoneSettingId Int     @map("user_zone_setting_id")
  order             Int
  color             String?
  min               Int?
  max               Int?
  name              String?

  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  userZoneSetting UserZoneSetting @relation(fields: [userZoneSettingId], references: [id], onDelete: Cascade)

  @@unique([userZoneSettingId, order], map: "t_user_zones_user_zone_setting_id_order_key")
  @@map("t_user_zones")
}

// 是否自动更新表（全局按指标控制，不区分运动类型）
model UserAutoUpdateConfig {
  id        String                @id @default(cuid())
  userId    String                @map("user_id")
  user      T_user                @relation(fields: [userId], references: [id], onDelete: Cascade)
  metric    UserFitnessMetricType
  enabled   Boolean               @default(true)
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")

  @@unique([userId, metric])
  @@index([userId])
  @@map("t_user_auto_update_config")
}

// Unified user fitness metric record table
// Replaces UserPowerThreshold, UserHeartRateThreshold, UserPaceThreshold
model UserFitnessMetric {
  id     String    @id @default(cuid())
  userId String    @map("user_id")
  user   T_user    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sport  SportType @default(UNKNOWN) // Sport type (UNKNOWN for global metrics)

  type UserFitnessMetricType @map("type")

  // Core value (e.g., CP, FTP, MaxHR)
  value Float @map("value")

  // Secondary value if needed (e.g., W' for CP, D' for CS)
  value2     Float?       @map("value2")
  source     MetricSource @default(MANUAL) @map("source")
  recordedAt DateTime     @default(now()) @map("recorded_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  // 来源归因：ESTIMATED 保存系统估算，AUTO/MANUAL 参与生效值选择，SNAPSHOT 保存快照；originProvider 记录具体第三方来源。
  changeSource     ChangeSource?       @map("change_source")
  originProvider   ThirdPartyProvider? @map("origin_provider")
  originExternalId String?             @map("origin_external_id")
  originChecksum   String?             @map("origin_checksum")
  originPayload    Json?               @map("origin_payload")
