/// 教练计划上下文（一个计划周期一个容器）
model CoachContext {
  id     String @id @default(cuid())
  userId String @map("user_id")
  planId String @unique @map("plan_id")

  status CoachContextStatus @default(ACTIVE)

  startDate    DateTime? @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  closedAt     DateTime? @map("closed_at")
  /// 当前事实事件游标（用于 optimistic apply）
  headEventSeq Int       @default(0) @map("head_event_seq")
  /// 上下文版本号（状态推进/迁移）
  version      Int       @default(1) @map("version")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user            T_user                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            Plan                  @relation(fields: [planId], references: [id], onDelete: Cascade)
  events          CoachEvent[]
  summary         CoachSummary?
  threads         CoachThread[]
  branches        CoachBranch[]
  decisions       CoachDecision[]
  commits         CoachCommit[]
  assessmentCases CoachAssessmentCase[]

  @@unique([userId, planId])
  @@index([userId, headEventSeq])
  @@index([userId, status, updatedAt(sort: Desc)])
  @@index([planId])
  @@map("t_coach_context")
}

/// 教练上下文事件（仅追加，不可变）
model CoachEvent {
  id        String         @id @default(cuid())
  contextId String         @map("context_id")
  seq       Int            @map("seq")
  type      CoachEventType @map("type")

  occurredAt    DateTime @map("occurred_at")
  source        String?  @map("source")
  dedupeKey     String?  @map("dedupe_key")
  payload       Json     @map("payload")
  schemaVersion Int      @default(1) @map("schema_version")
  decisionId    String?  @map("decision_id")
  branchId      String?  @map("branch_id")
  commitId      String?  @map("commit_id")

  createdAt DateTime @default(now()) @map("created_at")

  context  CoachContext   @relation(fields: [contextId], references: [id], onDelete: Cascade)
  decision CoachDecision? @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  branch   CoachBranch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  commit   CoachCommit?   @relation(fields: [commitId], references: [id], onDelete: SetNull)

  @@unique([contextId, seq])
  @@index([contextId, occurredAt(sort: Desc)])
  @@index([contextId, seq(sort: Desc)])
  @@index([decisionId])
  @@index([branchId])
  @@index([commitId])
  @@index([type, occurredAt(sort: Desc)])
  @@index([dedupeKey])
  @@map("t_coach_event")
}

/// 教练周期总结（周期完成后固化）
model CoachSummary {
  id        String @id @default(cuid())
  contextId String @unique @map("context_id")
  userId    String @map("user_id")
  planId    String @unique @map("plan_id")

  periodStart DateTime? @map("period_start") @db.Date
  periodEnd   DateTime? @map("period_end") @db.Date

  adherenceScore Float?              @map("adherence_score")
  progressLabel  CoachProgressLabel? @map("progress_label")

  keyDrivers          Json?   @map("key_drivers")
  riskFlags           Json?   @map("risk_flags")
  nextCycleSuggestion Json?   @map("next_cycle_suggestion")
  markdown            String? @map("markdown") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  context CoachContext @relation(fields: [contextId], references: [id], onDelete: Cascade)
  user    T_user       @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan    Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([planId])
  @@map("t_coach_summary")
}

/// 对话主线程（MAIN / SYSTEM）
model CoachThread {
  id         String          @id @default(cuid())
  contextId  String          @map("context_id")
  kind       CoachThreadKind @default(MAIN) @map("kind")
  status     CoachFlowStatus @default(OPEN) @map("status")
  headMsgSeq Int             @default(0) @map("head_msg_seq")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  context  CoachContext         @relation(fields: [contextId], references: [id], onDelete: Cascade)
  branches CoachBranch[]
  messages CoachBranchMessage[]

  @@index([contextId, kind])
  @@index([contextId, status])
  @@map("t_coach_thread")
}

/// 从 thread 切出的讨论分支
model CoachBranch {
  id           String          @id @default(cuid())
  threadId     String          @map("thread_id")
  contextId    String          @map("context_id")
  status       CoachFlowStatus @default(OPEN) @map("status")
  baseEventSeq Int             @map("base_event_seq")
  baseCommitId String?         @map("base_commit_id")
  openedBy     String?         @map("opened_by")
  openReason   String?         @map("open_reason")
  headMsgSeq   Int             @default(0) @map("head_msg_seq")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  closedAt     DateTime?       @map("closed_at")

  thread          CoachThread             @relation(fields: [threadId], references: [id], onDelete: Cascade)
  context         CoachContext            @relation(fields: [contextId], references: [id], onDelete: Cascade)
  messages        CoachBranchMessage[]
  compactions     CoachBranchCompaction[]
  decisions       CoachDecision[]
  events          CoachEvent[]
  assessmentCases CoachAssessmentCase[]

  @@index([contextId, status])
  @@index([threadId, status])
  @@index([contextId, baseEventSeq])
  @@map("t_coach_branch")
}

/// 分支消息流（结构化消息）
model CoachBranchMessage {
  id          String   @id @default(cuid())
  threadId    String   @map("thread_id")
  branchId    String?  @map("branch_id")
  msgSeq      Int      @map("msg_seq")
  role        String   @map("role")
  content     Json     @map("content")
  toolCalls   Json?    @map("tool_calls")
  toolResults Json?    @map("tool_results")
  parentMsgId String?  @map("parent_msg_id")
  tokenIn     Int?     @map("token_in")
  tokenOut    Int?     @map("token_out")
  createdAt   DateTime @default(now()) @map("created_at")

  thread CoachThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  branch CoachBranch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([threadId, msgSeq])
  @@index([branchId, msgSeq])
  @@index([threadId, createdAt(sort: Desc)])
  @@map("t_coach_branch_message")
}

/// 分支压缩摘要（减少上下文 token）
model CoachBranchCompaction {
  id          String   @id @default(cuid())
  branchId    String   @map("branch_id")
  fromSeq     Int      @map("from_seq")
  toSeq       Int      @map("to_seq")
