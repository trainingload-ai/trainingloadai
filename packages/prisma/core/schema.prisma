// Authoritative public/Core Prisma schema.
// This schema contains only public domain models. Managed extensions are composed privately.

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/core"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [] // Remove version numbers, use default versions
}

