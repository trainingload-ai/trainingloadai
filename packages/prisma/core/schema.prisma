/// 用户全量数据导出模式
enum UserDataExportMode {
  FULL_BACKUP
  AI_ANALYSIS

  @@map("enum_user_data_export_mode")
}

/// 导出包中的位置隐私策略
enum UserDataExportLocationPrivacy {
  EXACT
  REDACT_FREQUENT_LOCATIONS
  REMOVE_GPS

  @@map("enum_user_data_export_location_privacy")
}

/// 活动复算任务状态
enum ActivityRecomputeJobStatus {
