/// Apple HealthKit is authorized and queried on the user's device, not by the server.
/// This row stores per-device sync state such as requested types and HealthKit anchors.

/// Immutable-ish Apple Health raw sample store. Treat this table as the source of truth for Apple-origin health facts.
/// Existing product tables and daily summaries should be derived from these rows, not written as the only copy.

/// Recomputable daily projection from AppleHealthSample.
/// Populate this after raw Apple sample sync is reliable; rebuild it when raw samples or mapping rules change.

/// Provider-neutral raw/candidate health facts. Apple Health can retain Apple-specific raw tables,
/// but should project here so COROS, Apple Health, and future providers share one aggregation layer.
model ExternalHealthSample {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   T_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider        HealthDataProvider       @map("provider")
  connectionId    String?                  @map("connection_id")
  sourceObjectId  String?                  @map("source_object_id")
  sourceObject    ImportSourceObject?      @relation(fields: [sourceObjectId], references: [id], onDelete: SetNull)
  snapshotId      String?                  @map("snapshot_id")
  snapshot        CanonicalHealthSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  dailyMetricId   String?                  @map("daily_metric_id")
  dailyMetric     UserDailyHealthMetric?   @relation(fields: [dailyMetricId], references: [id], onDelete: SetNull)
  sourceNamespace String?                  @map("source_namespace")

  metricType HealthMetricType @map("metric_type")
  externalId String           @map("external_id")

  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")
  localDate DateTime @map("local_date") @db.Date
  timezone  String?

  value           Float?
  unit            String?
  sourceName      String?   @map("source_name")
  sourcePriority  Int?      @map("source_priority")
  aggregation     String?
  sourceUpdatedAt DateTime? @map("source_updated_at")
  projectToDaily  Boolean   @default(true) @map("project_to_daily")
  rawPayload      Json?     @map("raw_payload")
  metadata        Json?
  deletedAt       DateTime? @map("deleted_at")

  @@unique([userId, provider, metricType, externalId])
  @@index([userId, metricType, localDate])
  @@index([provider, connectionId])
  @@index([sourceObjectId])
  @@index([snapshotId])
  @@index([dailyMetricId, deletedAt])
  @@index([userId, sourceNamespace, localDate])
  @@index([userId, deletedAt])
  @@map("t_external_health_sample")
}

/// Provider-neutral daily health fact selected from ExternalHealthSample and provider-specific summaries.
