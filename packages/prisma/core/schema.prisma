model PlanWorkout {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   T_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId String? @map("plan_id")
  plan   Plan?   @relation(fields: [planId], references: [id], onDelete: Cascade)

  dayOffset    Int @map("day_offset")
  sessionIndex Int @default(1) @map("session_index")

  scheduledDate DateTime? @map("scheduled_date") @db.Date

  sportType              SportType            @map("sport_type")
  sportDefinitionCode    String?              @map("sport_definition_code")
  sportDefinition        SportDefinition?     @relation(fields: [sportDefinitionCode], references: [code], onDelete: SetNull)
  name                   String?
  text                   String
  notes                  String?
  structureKind          WorkoutStructureKind @default(ENDURANCE) @map("structure_kind")
  dslVersion             Int                  @default(1) @map("dsl_version")
  plannedDurationSeconds Int?                 @map("planned_duration_seconds")
  plannedSessionRpe      Float?               @map("planned_session_rpe")
  revision               Int                  @default(1)

  status      PlanWorkoutStatus @default(PLANNED)
  completedAt DateTime?         @map("completed_at")
  skippedAt   DateTime?         @map("skipped_at")

  // 拷贝式顺延：旧行留在原日 status=MOVED；新行在目标日 status=PLANNED，
  // 且 new.movedFromWorkoutId = old.id。movedBy 区分手动推迟与教练推迟。
  movedFromWorkoutId String?             @map("moved_from_workout_id")
  movedFromWorkout   PlanWorkout?        @relation("PlanWorkoutMove", fields: [movedFromWorkoutId], references: [id], onDelete: SetNull)
  movedToWorkouts    PlanWorkout[]       @relation("PlanWorkoutMove")
  movedBy            PlanWorkoutMovedBy? @map("moved_by")

  // 期望负荷快照（仅在 DRAFT→ACTIVE 时落库；ACTIVE/PAUSED 下编辑增量重算；DRAFT 始终为 null）
  // estimatedLoad：单位与 bikeStress / trimp100 一致（「100 = 1h @ 阈值」）
  // estimatedLoadSource：该课的主导 target（按 IF² × sec 贡献加权 top1）
  // estimatedLoadInputs：阈值快照 + 逐步贡献，便于排查
  estimatedLoad           Float?          @map("estimated_load")
  estimatedLoadSource     PlanLoadSource? @map("estimated_load_source")
  estimatedLoadInputs     Json?           @map("estimated_load_inputs")
  estimatedLoadComputedAt DateTime?       @map("estimated_load_computed_at")

  steps             PlanWorkoutStep[]
  strengthExercises PlanWorkoutExercise[]
  links             PlanWorkoutActivityLink[]
  externalMappings  PlanWorkoutExternalMapping[]

  @@unique([planId, dayOffset, sessionIndex])
  @@index([userId, scheduledDate])
  @@index([userId, status])
  @@index([userId, planId])
  @@index([planId, dayOffset])
  @@index([planId, scheduledDate])
  @@index([planId, status])
  @@index([sportDefinitionCode])
  @@map("t_plan_workout")
}

