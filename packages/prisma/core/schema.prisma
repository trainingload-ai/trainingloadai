}

/// Versioned, provider-neutral manifest produced from one raw health source object.
/// High-frequency point data is stored in HealthSeriesFile parquet objects instead of this JSON row.
model CanonicalHealthSnapshot {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   T_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  itemJobId String        @unique @map("item_job_id")
  itemJob   ImportItemJob @relation(fields: [itemJobId], references: [id], onDelete: Cascade)

  sourceObjectId String             @unique @map("source_object_id")
  sourceObject   ImportSourceObject @relation(fields: [sourceObjectId], references: [id], onDelete: Cascade)

  schemaVersion     String  @default("v1") @map("schema_version")
  parserName        String  @default("trackswap") @map("parser_name")
  parserVersion     String  @map("parser_version")
  fitProfileVersion String? @map("fit_profile_version")

  primaryKind      String    @map("primary_kind")
  detectedKinds    Json      @map("detected_kinds")
  observedStart    DateTime? @map("observed_start")
  observedEnd      DateTime? @map("observed_end")
  localDateStart   DateTime? @map("local_date_start") @db.Date
  localDateEnd     DateTime? @map("local_date_end") @db.Date
  timezoneStrategy String?   @map("timezone_strategy")

  pointCount    Int @default(0) @map("point_count")
  intervalCount Int @default(0) @map("interval_count")
  sessionCount  Int @default(0) @map("session_count")
  summaryCount  Int @default(0) @map("summary_count")

  manifest          Json
  diagnostics       Json?
  canonicalChecksum String @map("canonical_checksum")

  seriesFiles    HealthSeriesFile[]
  sessions       ExternalHealthSession[]
  projectedFacts ExternalHealthSample[]

  @@index([userId, observedStart])
  @@index([userId, localDateStart])
  @@map("t_canonical_health_snapshot")
}

/// Object-storage manifest for one normalized health metric and local-day parquet partition.
model HealthSeriesFile {
