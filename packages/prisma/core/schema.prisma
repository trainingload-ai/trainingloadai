  QUEUED
  NORMALIZING
  DEDUPING
  MATERIALIZING
  PARQUET_BUILDING
  ANALYZING
  DONE
  SKIPPED
  FAILED
  DEAD

  @@map("enum_import_item_job_status")
}

/// 用户级后处理任务状态（batch 收口后执行）
enum UserPostProcessJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  DEAD

  @@map("enum_user_post_process_job_status")
}

/// 账户异步删除任务状态
enum AccountDeletionJobStatus {
  QUEUED
  REVOKING_PROVIDERS
  DELETING_STORAGE
  PURGING_DATABASE
  RETRY_WAIT
  MANUAL_REVIEW
  COMPLETED

  @@map("enum_account_deletion_job_status")
}

/// 账户异步删除任务可恢复阶段
enum AccountDeletionJobStage {
  REVOKING_PROVIDERS
  DELETING_STORAGE
  PURGING_DATABASE

  @@map("enum_account_deletion_job_stage")
}

/// 用户全量数据导出任务状态
enum UserDataExportJobStatus {
