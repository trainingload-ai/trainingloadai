  publicId String @unique @map("public_id") @db.Char(12)

  ownerUserId String? @map("owner_user_id")
  owner       T_user? @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  parentLineageId String?            @map("parent_lineage_id")
  parentLineage   PlanShareLineage?  @relation("PlanShareLineageFork", fields: [parentLineageId], references: [id], onDelete: SetNull)
  childLineages   PlanShareLineage[] @relation("PlanShareLineageFork")
  rootLineageId   String             @map("root_lineage_id")

  visibility PlanShareVisibility
  status     PlanShareStatus     @default(ACTIVE)
  origin     PlanShareOrigin

  title       String
  description String?
  goal        String?
  sportTypes  SportType[] @map("sport_types")
  locale      String      @default("en")

  headShareId String? @unique @map("head_share_id")
  headPlanId  String? @map("head_plan_id")

  catalogSlug String?   @unique @map("catalog_slug")
  catalogTags String[]  @map("catalog_tags")
  publishedAt DateTime? @map("published_at")
  revokedAt   DateTime? @map("revoked_at")

  shares PlanShare[]

  @@index([ownerUserId, status])
  @@index([visibility, status, origin])
  @@index([parentLineageId])
  @@index([rootLineageId])
  @@map("t_plan_share_lineage")
}

model PlanShare {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  publicId String @unique @map("public_id") @db.Char(12)

  lineageId String           @map("lineage_id")
  lineage   PlanShareLineage @relation(fields: [lineageId], references: [id], onDelete: Cascade)
  version   Int

