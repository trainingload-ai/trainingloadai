// 记录 PMC 极值
model PMCExtreme {
  id        String         @id @default(cuid())
  createdAt DateTime       @default(now()) @map("created_at")
  valueType PMCExtremeType @map("value_type")
  value     Float          @map("value")
}

/// 单活动 AI 教练分析：活动入库/重算后异步生成，供活动详情页直接展示。
model ActivityAiReview {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  activityId Int      @map("activity_id")
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       T_user   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status   ActivityAiReviewStatus  @default(PENDING)
  trigger  ActivityAiReviewTrigger @default(IMPORT)
  language String                  @default("zh")

  promptVersion   String @default("activity_ai_review_v1") @map("prompt_version")
  evidenceVersion String @default("activity_review_evidence_v1") @map("evidence_version")
  evidenceHash    String @map("evidence_hash")

  /// Prompt 输入证据快照：只存聚合后的单活动指标，不存完整原始 stream。
  evidence Json?   @map("evidence")
  /// 结构化分析结果 JSON：verdict/intensity/execution/hr/power/pace/load/coachNotes/missingData 等。
  content  Json?   @map("content")
  /// 便于列表/详情页快速展示与检索的短字段冗余。
  verdict  String? @map("verdict") @db.Text
  summary  String? @map("summary") @db.Text

  provider String?
  model    String?

  inputTokens         Int     @default(0) @map("input_tokens")
  outputTokens        Int     @default(0) @map("output_tokens")
  cachedInputTokens   Int     @default(0) @map("cached_input_tokens")
  billableInputTokens Int     @default(0) @map("billable_input_tokens")
  weightedTokens      Int     @default(0) @map("weighted_tokens")
  costMicroYuan       BigInt? @map("cost_micro_yuan")

  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  availableAt DateTime  @default(now()) @map("available_at")
  lockedAt    DateTime? @map("locked_at")
  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  generatedAt DateTime? @map("generated_at")
  failedAt    DateTime? @map("failed_at")

  errorCode    String? @map("error_code")
  errorMessage String? @map("error_message") @db.Text

  /// 手动刷新/回填/实验标记等扩展元信息。
  metadata Json? @map("metadata")

  @@unique([activityId, userId, promptVersion, evidenceVersion, evidenceHash], name: "activity_ai_review_dedupe", map: "t_activity_ai_review_dedupe_key")
  @@index([activityId, userId, status, generatedAt], map: "t_activity_ai_review_activity_id_user_id_status_generated_a_idx")
  @@index([userId, createdAt], map: "t_activity_ai_review_user_id_created_at_idx")
  @@index([status, availableAt], map: "t_activity_ai_review_status_available_at_idx")
  @@index([trigger, createdAt], map: "t_activity_ai_review_trigger_created_at_idx")
  @@map("t_activity_ai_review")
}

// Activity polyline table - Stores activity GPS polyline data
model ActivityPolyline {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  activityId Int      @unique @map("activity_id")
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  polyline String

  @@index([activityId])
  @@map("t_activity_polyline")
}

// Ordered route segments. Unlike ActivityPolyline, this preserves real gaps
// and lap-separated source tracks without drawing artificial connecting lines.
model ActivityPolylineSegment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  activityId   Int      @map("activity_id")
  activity     Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  segmentIndex Int      @map("segment_index")
  polyline     String

  @@unique([activityId, segmentIndex], map: "t_activity_polyline_segment_activity_segment_key")
  @@index([activityId], map: "t_activity_polyline_segment_activity_id_idx")
  @@map("t_activity_polyline_segment")
}

// ThirdPartyActivity 表 - 存储Third-party provider的原始Activity数据
model ThirdPartyActivity {
  id Int @id @default(autoincrement())

  // Third-party provider信息
  provider       ThirdPartyProvider // Data source provider
  externalId     String             @map("external_id") // Third-party provider的ActivityID
  externalUserId String?            @map("external_user_id") // Third-party provider的UserID

  // Raw data storage
  rawData     Json   @map("raw_data") // Complete raw JSON data
  dataVersion String @default("1.0") @map("data_version") // Data version

  // Standardized core fields（Extracted from raw data）
  activityName String?    @map("activity_name")
  activityType SportType? @map("activity_type")
  sportType    SportType? @map("sport_type")
  description  String?

  // Time info
  startTime DateTime? @map("start_time")
  endTime   DateTime? @map("end_time")
  timezone  String? // Timezone info

  // Location info
  startLatitude  Float? @map("start_latitude")
  startLongitude Float? @map("start_longitude")
  endLatitude    Float? @map("end_latitude")
  endLongitude   Float? @map("end_longitude")

  // Sport data
  distance    Float? @map("distance") // Meters
  elapsedTime Int?   @map("elapsed_time") // Seconds
  movingTime  Int?   @map("moving_time") // Seconds
  ascent      Float? @map("ascent") // Meters
  descent     Float? @map("descent") // Meters

  // Speed data
  maxSpeed Float? @map("max_speed") // m/s
  avgSpeed Float? @map("avg_speed") // m/s

  // Heart rate data
  avgHeartRate Int? @map("avg_heart_rate") // bpm
  maxHeartRate Int? @map("max_heart_rate") // bpm

  // Power data
  avgPower        Float? @map("avg_power") // Watts
  maxPower        Float? @map("max_power") // Watts
  normalizedPower Float? @map("normalized_power") // Watts

  // Cadence data
  avgCadence Float? @map("avg_cadence") // rpm
  maxCadence Float? @map("max_cadence") // rpm

  // Calorie data
  calories Int? @map("calories")

  // Platform specific fields
  isPrivate  Boolean? @map("is_private")
  isManual   Boolean? @map("is_manual")
  deviceName String?  @map("device_name")
  gearId     String?  @map("gear_id")

  // Third-party import processing status
  processingStatus        ThirdPartyActivityProcessingStatus @default(PENDING) @map("sync_status")
  processedAt             DateTime?                          @map("synced_at")
  lastProcessingAttemptAt DateTime?                          @map("last_sync_attempt")
  processingErrorMessage  String?                            @map("sync_error_message")
  processingRetryCount    Int                                @default(0) @map("sync_retry_count")
  // 0 表示 不可见 1 表示 可见
  state                   Int                                @default(1) @map("state")

  // Data validation
  dataChecksum     String? @map("data_checksum") // Raw data checksum
  isDataValid      Boolean @default(true) @map("is_data_valid")
  validationErrors Json?   @map("validation_errors")

  // Relations
  userId String @map("user_id")
  user   T_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Mappings
  mappings ActivityThirdPartyMapping[]

  // Timestamp
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Indexes
  @@unique([provider, externalId]) // Ensure unique activity ID per provider
  @@index([userId, provider])
  @@index([startTime])
  @@index([processingStatus])
  @@index([provider, externalId])
  @@map("t_third_party_activity")
}

// Activity与第三方Activity的Mappings表
model ActivityThirdPartyMapping {
  id Int @id @default(autoincrement())

  // Related activity
  activityId Int      @map("activity_id")
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  // Related third-party activity
  thirdPartyActivityId Int                @map("third_party_activity_id")
  thirdPartyActivity   ThirdPartyActivity @relation(fields: [thirdPartyActivityId], references: [id], onDelete: Cascade)

  // Mapping metadata
  mappingType    MappingType @default(EXACT) @map("mapping_type")
  confidence     Float       @default(1.0) // Mapping confidence 0-1
  matchingFields Json?       @map("matching_fields") // Matched fields info

  // Mapping status
  isActive  Boolean @default(true) @map("is_active")
  isPrimary Boolean @default(false) @map("is_primary") // Is primary data source

  // Data sync direction
  syncDirection SyncDirection @default(IMPORT) @map("sync_direction")
  lastSyncedAt  DateTime?     @map("last_synced_at")

  // Creation info
  createdBy String?  @map("created_by") // Creator（系统/User）
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Ensure one third-party activity maps to only one activity
  @@unique([thirdPartyActivityId])
  @@index([activityId])
  @@index([activityId, isActive, isPrimary])
  @@index([thirdPartyActivityId])
  @@map("t_activity_third_party_mapping")
}

