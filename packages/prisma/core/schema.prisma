  digest   ReviewDigest @relation(fields: [digestId], references: [id], onDelete: Cascade)

  sportType   SportType @map("sport_type")
  sessions    Int?      @map("sessions")
  durationSec Int?      @map("duration_sec")
  distanceM   Float?    @map("distance_m")
  tss         Float?    @map("tss")

  @@unique([digestId, sportType])
  @@map("t_review_digest_totals_by_sport")
}

/// 复盘输入明细：Top 训练列表
model ReviewDigestHighlightActivity {
  id       String       @id @default(cuid())
  digestId String       @map("digest_id")
  digest   ReviewDigest @relation(fields: [digestId], references: [id], onDelete: Cascade)

  rank       Int        @map("rank")
  activityId Int?       @map("activity_id")
  sportType  SportType? @map("sport_type")

  startTime   DateTime? @map("start_time")
  durationSec Int?      @map("duration_sec")
  distanceM   Float?    @map("distance_m")
  tss         Float?    @map("tss")
  title       String?   @map("title")

  @@unique([digestId, rank])
  @@index([digestId, rank])
  @@map("t_review_digest_highlight_activity")
}

/// 复盘输入明细：趋势点（按天/周粒度）
model ReviewDigestTrendPoint {
  id       String       @id @default(cuid())
  digestId String       @map("digest_id")
  digest   ReviewDigest @relation(fields: [digestId], references: [id], onDelete: Cascade)

  pointDate   DateTime @map("point_date")
  sessions    Int?     @map("sessions")
  durationSec Int?     @map("duration_sec")
  distanceM   Float?   @map("distance_m")
  tss         Float?   @map("tss")

  @@unique([digestId, pointDate])
  @@index([digestId, pointDate])
  @@map("t_review_digest_trend_point")
}

/// 复盘输入明细：风险/提示项
model ReviewDigestWarning {
  id       String       @id @default(cuid())
  digestId String       @map("digest_id")
  digest   ReviewDigest @relation(fields: [digestId], references: [id], onDelete: Cascade)

  code     String  @map("code")
  severity String? @map("severity")
  message  String? @map("message") @db.Text

  @@index([digestId])
  @@map("t_review_digest_warning")
}

/// 站内通知（轮询拉取）
model Notification {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   T_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind         NotificationKind @map("kind")
  title        String           @map("title")
  /// 去重 key：同一来源事件可用此值保证幂等落库（可空，空则不参与去重）
  dedupeKey    String?          @map("dedupe_key")
  bodyMarkdown String?          @map("body_markdown") @db.Text
  data         Json?            @map("data")

  digestId String?       @map("digest_id")
  digest   ReviewDigest? @relation(fields: [digestId], references: [id], onDelete: SetNull)

  importBatchJobId String?         @map("import_batch_job_id")
  importBatchJob   ImportBatchJob? @relation("NotificationImportBatch", fields: [importBatchJobId], references: [id], onDelete: SetNull)

  readAt      DateTime? @map("read_at")
  visibleAt   DateTime  @default(now()) @map("visible_at") @db.Timestamptz(3)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([userId, kind, dedupeKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@index([userId, visibleAt, createdAt(sort: Desc)])
  @@index([kind, visibleAt, cancelledAt])
  @@index([importBatchJobId])
  @@map("t_notification")
}

// User sessions - login sessions
model T_user_sessions {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  t_user    T_user   @relation(fields: [userId], references: [id], onDelete: Cascade)

  oauthAccessTokens  oauthAccessToken[]
  oauthRefreshTokens oauthRefreshToken[]

  @@unique([token])
  @@map("t_user_sessions")
}

// User accounts - third-party account info
model T_user_accounts {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  t_user                T_user    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @map("created_at")
  updatedAt             DateTime  @map("updated_at")

  @@map("t_user_accounts")
}

// Email verifications
model T_user_verifications {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @map("created_at")
  updatedAt  DateTime? @map("updated_at")

  @@map("t_user_verifications")
}

/// 跨进程共享的认证限流计数。Better Auth 和自定义 OTP 防刷共用此表，key 使用命名空间隔离。
model AuthRateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("t_auth_rate_limits")
}

/// OAuth clients registered by external clients through Better Auth.
model oauthClient {
  id                               String   @id @default(cuid())
  clientId                         String   @unique @map("client_id")
  clientSecret                     String?  @map("client_secret")
  clientDiscoveryId                String?  @map("client_discovery_id")
  disabled                         Boolean  @default(false)
  skipConsent                      Boolean? @map("skip_consent")
  enableEndSession                 Boolean? @map("enable_end_session")
  subjectType                      String?  @map("subject_type")
  scopes                           String[] @default([])
  clientCredentialsScopes          String[] @default([]) @map("client_credentials_scopes")
  userId                           String?  @map("user_id")
  user                             T_user?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                        DateTime @default(now()) @map("created_at")
  updatedAt                        DateTime @updatedAt @map("updated_at")
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[] @default([])
  tos                              String?
  policy                           String?
  softwareId                       String?  @map("software_id")
  softwareVersion                  String?  @map("software_version")
  softwareStatement                String?  @map("software_statement")
  redirectUris                     String[] @map("redirect_uris")
  postLogoutRedirectUris           String[] @default([]) @map("post_logout_redirect_uris")
  backchannelLogoutUri             String?  @map("backchannel_logout_uri")
  backchannelLogoutSessionRequired Boolean? @map("backchannel_logout_session_required")
  tokenEndpointAuthMethod          String?  @map("token_endpoint_auth_method")
  applicationType                  String?  @map("application_type")
  jwks                             String?
  jwksUri                          String?  @map("jwks_uri")
  grantTypes                       String[] @default([]) @map("grant_types")
  responseTypes                    String[] @default([]) @map("response_types")
  public                           Boolean?
  type                             String?
  requirePKCE                      Boolean? @map("require_pkce")
  dpopBoundAccessTokens            Boolean? @default(false) @map("dpop_bound_access_tokens")
  referenceId                      String?  @map("reference_id")
  metadata                         Json?

  accessTokens    oauthAccessToken[]
  refreshTokens   oauthRefreshToken[]
  consents        oauthConsent[]
  clientResources oauthClientResource[]

  @@index([userId])
  @@map("t_oauth_client")
}

/// Opaque OAuth refresh tokens issued to external clients through Better Auth.
model oauthRefreshToken {
  id                      String           @id @default(cuid())
  token                   String           @unique
  clientId                String           @map("client_id")
  client                  oauthClient      @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?          @map("session_id")
  session                 T_user_sessions? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String           @map("user_id")
  user                    T_user           @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?          @map("reference_id")
  authorizationCodeId     String?          @map("authorization_code_id")
  resources               String[]         @default([])
  requestedUserInfoClaims String[]         @default([]) @map("requested_user_info_claims")
  expiresAt               DateTime         @map("expires_at")
  createdAt               DateTime         @default(now()) @map("created_at")
  revoked                 DateTime?
  rotatedAt               DateTime?        @map("rotated_at")
  rotationReplayResponse  String?          @map("rotation_replay_response")
  rotationReplayExpiresAt DateTime?        @map("rotation_replay_expires_at")
  authTime                DateTime?        @map("auth_time")
  confirmation            Json?
  scopes                  String[]         @default([])

  accessTokens oauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("t_oauth_refresh_token")
}

/// OAuth access tokens issued to external clients through Better Auth.
model oauthAccessToken {
  id                      String             @id @default(cuid())
  token                   String             @unique
  clientId                String             @map("client_id")
  client                  oauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?            @map("session_id")
  session                 T_user_sessions?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?            @map("user_id")
  user                    T_user?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?            @map("reference_id")
  authorizationCodeId     String?            @map("authorization_code_id")
  resources               String[]           @default([])
  requestedUserInfoClaims String[]           @default([]) @map("requested_user_info_claims")
  refreshId               String?            @map("refresh_id")
  refresh                 oauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: SetNull)
  expiresAt               DateTime           @map("expires_at")
  createdAt               DateTime           @default(now()) @map("created_at")
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]           @default([])

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([refreshId])
  @@index([authorizationCodeId])
  @@map("t_oauth_access_token")
}

/// User consent records for external OAuth clients.
model oauthConsent {
  id                      String      @id @default(cuid())
  clientId                String      @map("client_id")
  client                  oauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?     @map("user_id")
  user                    T_user?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?     @map("reference_id")
  resources               String[]    @default([])
  requestedUserInfoClaims String[]    @default([]) @map("requested_user_info_claims")
  scopes                  String[]    @default([])
  createdAt               DateTime    @default(now()) @map("created_at")
  updatedAt               DateTime    @updatedAt @map("updated_at")

  @@index([clientId])
  @@index([userId])
  @@map("t_oauth_consent")
}

/// Protected resources for which the OAuth provider can issue access tokens.
model oauthResource {
  id                            String                @id @default(cuid())
  identifier                    String                @unique
  name                          String
  accessTokenTtl                Int?                  @map("access_token_ttl")
  refreshTokenTtl               Int?                  @map("refresh_token_ttl")
  signingAlgorithm              String?               @map("signing_algorithm")
  signingKeyId                  String?               @map("signing_key_id")
  allowedScopes                 String[]              @default([]) @map("allowed_scopes")
  customClaims                  Json?                 @map("custom_claims")
  dpopBoundAccessTokensRequired Boolean?              @default(false) @map("dpop_bound_access_tokens_required")
  disabled                      Boolean?              @default(false)
  createdAt                     DateTime              @default(now()) @map("created_at")
  updatedAt                     DateTime              @updatedAt @map("updated_at")
  policyVersion                 Int?                  @default(1) @map("policy_version")
  metadata                      Json?
  clients                       oauthClientResource[]

  @@map("t_oauth_resource")
}

/// Allow-list linkage between OAuth clients and protected resources.
model oauthClientResource {
  id         String        @id @default(cuid())
  clientId   String        @map("client_id")
  client     oauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId String        @map("resource_id")
  resource   oauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata   Json?
  createdAt  DateTime      @default(now()) @map("created_at")

  @@unique([clientId, resourceId])
  @@index([clientId])
  @@index([resourceId])
  @@map("t_oauth_client_resource")
}

/// Single-use private_key_jwt assertion identifiers retained until expiry.
model oauthClientAssertion {
  id        String   @id
  expiresAt DateTime @map("expires_at")

  @@map("t_oauth_client_assertion")
}

/// JSON Web Key Set used by Better Auth's JWT plugin.
model jwks {
  id         String    @id @default(cuid())
  publicKey  String    @map("public_key")
  privateKey String    @map("private_key")
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime? @map("expires_at")
  alg        String?
  crv        String?

  @@map("t_jwks")
}

// Activity - aligned with Strava data model
model Activity {
  id                  Int                        @id @default(autoincrement())
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")
  hashId              String                     @unique @map("hash_id") // Hash ID
  // Uploaded file metadata
  fileKey             String?                    @map("file_key") // Storage key
  fileType            String?                    @map("file_type") // File type
  fileName            String?                    @map("file_name") // File name
  fileSize            Int?                       @map("file_size") // File size
  fileLink            String?                    @map("file_link") // Server link
  userId              String                     @map("user_id")
  user                T_user                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planWorkoutLinks    PlanWorkoutActivityLink[]
  strengthExercises   ActivityStrengthExercise[]
  createdByBatchJobId String?                    @map("created_by_batch_job_id")
  createdByBatchJob   ImportBatchJob?            @relation("ActivityCreatedByBatch", fields: [createdByBatchJobId], references: [id], onDelete: SetNull)

  // ========== Trackswap fields ==========
  index               Int?
  activityName        String?          @map("activity_name")
  sportType           SportType?       @map("sport_type")
  sportDefinitionCode String?          @map("sport_definition_code")
  sportDefinition     SportDefinition? @relation(fields: [sportDefinitionCode], references: [code], onDelete: SetNull)
  /// FIT Profile 的原始 `sub_sport` 数字枚举；API 业务小类使用 sportDefinitionCode/subSportType。
  subSport            Int?             @map("sub_sport")
  description         String?
  /// User-entered session RPE (commonly 1–10); used when PMC loadSources prioritize SESSIONRPE
  sessionRpe          Float?           @map("session_rpe")
  timestamp           DateTime?
  startTime           DateTime?        @map("start_time")
  endTime             DateTime?        @map("end_time")
  timezone            String?          @map("timezone")
  // Sensor record sampling interval in seconds, inferred during records bootstrap.
  sampleSec           Float?           @map("sample_sec")
  startLat            Float?           @map("start_lat")
  startLng            Float?           @map("start_lng")
  endLat              Float?           @map("end_lat")
  endLng              Float?           @map("end_lng")

  timerTime              Int?                            @map("timer_time")
  elapsedTime            Int?                            @map("elapsed_time")
  distance               Float?                          @map("distance")
  ascent                 Float?                          @map("ascent")
  descent                Float?                          @map("descent")
  // Pool length
  poolLength             Float?                          @map("pool_length")
  // Pool length unit
  poolLengthUnit         String?                         @map("pool_length_unit")
  numLaps                Int?                            @map("num_laps")
  // Number of lengths
  numLengths             Int?                            @map("num_lengths")
  // Number of active lengths
  numActiveLengths       Int?                            @map("num_active_lengths")
  // High-precision elevation metrics
  enhancedAscent         Float?                          @map("enhanced_ascent") // Total ascent (enhanced elevation service)
  enhancedDescent        Float?                          @map("enhanced_descent") // Total descent (enhanced elevation service)
  enhancedMinElevation   Float?                          @map("enhanced_min_elevation") // Min elevation (enhanced)
  enhancedMaxElevation   Float?                          @map("enhanced_max_elevation") // Max elevation (enhanced)
  maxSpeed               Float?                          @map("max_speed")
  avgSpeed               Float?                          @map("avg_speed")
  // Min power
  minPower               Float?                          @map("min_power")
  // Max power
  maxPower               Float?                          @map("max_power")
  // Avg power
  avgPower               Float?                          @map("avg_power")
  // Avg cadence
  avgCadence             Float?                          @map("avg_cadence")
  // Max cadence
  maxCadence             Float?                          @map("max_cadence")
  // Avg heart rate
  avgHeartRate           Int?                            @map("avg_heart_rate")
  // Max heart rate
  maxHeartRate           Int?                            @map("max_heart_rate")
  // min heart rate
  minHeartRate           Int?                            @map("min_heart_rate")
  // Total cycles
  cycles                 Int?                            @map("cycles")
  // Total work
  work                   Int?                            @map("work")
  // Total strokes
  strokes                Int?                            @map("strokes")
  // Total calories
  calories               Int?                            @map("calories")
  // Total fat calories
  fatCalories            Int?                            @map("fat_calories")
  aePower                Float?                          @map("ae_power")
  re                     Float?                          @map("re")
  ei                     Float?                          @map("ei")
  // AerobicDecoupling
  // Power to Heart Rate (PW-HR)
  pwHr                   Float?                          @map("aerobic_decoupling_pw_hr")
  // Pace to Heart Rate (PA-HR AerobicDecoupling)
  paHr                   Float?                          @map("aerobic_decoupling_pa_hr")
  // Average Left/Right Balance
  avgLeftRightBalance    Float?                          @map("avg_left_right_balance")
  // 最大心率下降
  maxHrDrop              Int?                            @map("max_hr_drop")
  avgAerobicEfficiency   Float?                          @map("avg_aerobic_efficiency")
  avgGAP                 Float?                          @map("avg_gap") // s/m
  effectiveDistance      Float?                          @map("effective_distance") // meters, distance adjusted for elevation
  NGP                    Float?                          @map("ngp") // Normalized graded pace
  xPace                  Float?                          @map("x_pace") // Normalized Pace sec/m
  xGap                   Float?                          @map("x_gap") // Normalized Gap sec/m
  viPace                 Float?                          @map("vi_pace") // Normalized Pace sec/m
  viGap                  Float?                          @map("vi_gap") // Normalized Gap sec/m
  fitnessMetricsSnapshot ActivityFitnessMetricsSnapshot?
  weatherSnapshot        ActivityWeatherSnapshot?
  // Third-party integration fields
  // Third-party provider enum
  thirdPartyProvider     ThirdPartyProvider?             @map("third_party_provider")
  // Third-party platform activity ID
  thirdPartyActivityId   String?                         @map("third_party_activity_id")
  // Sync time
  syncedAt               DateTime?                       @map("synced_at")
  // 估算的 FTP
  eftp                   Float?                          @map("e_ftp")
  // 估算的 CP
  ecp                    Float?                          @map("e_cp")
  // 估算的 Wb
  ewPrime                Float?                          @map("e_w_prime")
  // 估算的 epmax
  epmax                  Float?                          @map("e_pmax")
  // Related laps
  laps                   ActivityLap[]

  // Related Parquet file info
  parquetFiles       ActivityParquetFile[]
  storageGarbage     StorageObjectGarbage[]
  polyline           ActivityPolyline?
  polylineSegments   ActivityPolylineSegment[]
  mapThumbJob        ActivityMapThumbJob?
  aiReviews          ActivityAiReview[]
  activityZones      ActivityZone[]
  // Related third-party activity mappings
  thirdPartyMappings ActivityThirdPartyMapping[]

  // Related peak metrics (power/hr/speed) and TT performances
  activityPeakMetrics    ActivityPeakMetric[]
  activityPerformanceTTs ActivityPerformanceTT[]
  lthrObservations       ActivityLthrObservation[]
  metricDistributions    ActivityMetricDistribution[]
  terrainSummary         ActivityTerrainSummary?

  // 0 表示 不可见 1 表示 可见
  state               Int                       @default(1) @map("state")
  status              ActivityStatus            @default(PADDING)
  processingStatus    ActivityProcessingStatus? @default(RECEIVED) @map("processing_status")
  processingUpdatedAt DateTime?                 @map("processing_updated_at")
  readyAt             DateTime?                 @map("ready_at")
  userBestMetrics     UserBestMetric[]
  userBestTTs         UserBestTT[]
  // coggan tss | rTss | swimTss
  coggan              ActivityCoggan?
  // skiba cycling
  bikeScore           ActivityBikeScore?

  // skiba swim
  swimScore                   ActivitySwimScore?
  // skiba run
  govss                       ActivityGOVSS?
  calculatedPower             ActivityCalculatedPower?
  trimp                       ActivityTrimp?
  vo2max                      ActivityVO2Max?
  // Related training effect/EPOC record (one-to-one)
  epoc                        ActivityTrainingEffect?
  importItemJobs              ImportItemJob[]          @relation("ImportItemActivity")
  activitySources             ActivitySource[]
  resolvedImportSourceObjects ImportSourceObject[]     @relation("ResolvedImportSourceObjects")

  /// 历史去重只软隐藏 loser，并保留旧 hashId 指向 survivor。
  mergedIntoActivityId Int?       @map("merged_into_activity_id")
  mergedIntoActivity   Activity?  @relation("ActivityHistoricalMerge", fields: [mergedIntoActivityId], references: [id], onDelete: SetNull)
  mergedActivities     Activity[] @relation("ActivityHistoricalMerge")

  @@unique([thirdPartyProvider, thirdPartyActivityId], name: "provider_activity_unique")
  @@index([startTime])
  @@index([hashId])
  @@index([userId, startTime])
  @@index([userId, sportType, startTime])
  @@index([sportDefinitionCode])
  @@index([userId, thirdPartyProvider, startTime])
  @@index([createdByBatchJobId])
  @@index([processingStatus, processingUpdatedAt])
  @@index([mergedIntoActivityId])
  @@map("t_activity")
}

/// 单项活动在真实时间轴中点附近的一次天气采样；同时承载可恢复的异步处理状态。
model ActivityWeatherSnapshot {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  activityId Int      @unique @map("activity_id")
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       T_user   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status            ActivityWeatherStatus             @default(PENDING)
  unavailableReason ActivityWeatherUnavailableReason? @map("unavailable_reason")

  sampleLatitudeE3  Int?      @map("sample_latitude_e3")
  sampleLongitudeE3 Int?      @map("sample_longitude_e3")
  queryRecordedAt   DateTime? @map("query_recorded_at")
  sampledAt         DateTime? @map("sampled_at")
  source            String?   @db.VarChar(32)
  sourceModified    Boolean   @default(true) @map("source_modified")

  attributionServiceName String? @map("attribution_service_name") @db.VarChar(64)
  attributionLegalUrl    String? @map("attribution_legal_url") @db.VarChar(512)
  inputFingerprint       String? @map("input_fingerprint") @db.VarChar(64)

  conditionCode       String? @map("condition_code") @db.VarChar(32)
  sourceConditionCode String? @map("source_condition_code") @db.VarChar(64)

  temperatureC         Float? @map("temperature_c")
  apparentTemperatureC Float? @map("apparent_temperature_c")
  dewPointC            Float? @map("dew_point_c")
  windChillC           Float? @map("wind_chill_c")
  heatIndexC           Float? @map("heat_index_c")
  windSpeedKph         Float? @map("wind_speed_kph")
  windGustKph          Float? @map("wind_gust_kph")
  windDirectionDeg     Int?   @map("wind_direction_deg")
  humidityPct          Int?   @map("humidity_pct")
  cloudCoverPct        Int?   @map("cloud_cover_pct")
  pressureHpa          Float? @map("pressure_hpa")

  normalizationVersion Int       @default(1) @map("normalization_version")
  fetchedAt            DateTime? @map("fetched_at")
  lastAttemptAt        DateTime? @map("last_attempt_at")
