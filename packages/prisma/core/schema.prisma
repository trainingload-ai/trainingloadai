/// AI 教练写动作审计 + 撤销账本
///
/// 用途：
/// - 每次 mutation tool 执行后落一行，前端拿 id 渲染「已完成 + 撤销」卡片
/// - LOW 风险动作 30s 内可点撤销；HIGH 风险动作不开 undo 窗口（reverseData 仍记录便于排障）
/// - forwardData 是写入参数快照、reverseData 是撤销所需快照（如旧 dayOffset/旧 status/旧 DSL/版本号）
///
/// 不引用 PlanWorkout / Activity，避免上游被删时阻塞撤销链路；undo 实现需自己处理「实体已不存在」。
model CoachAction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  userId String @map("user_id")
  user   T_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     CoachActionType     @map("type")
  riskTier CoachActionRiskTier @map("risk_tier")

  /// 给前端 / AI 复述用的一句中文摘要（例如「已在第 2 周第 3 天加一节 30min E 跑」）
  summary String @map("summary") @db.Text

  /// 已执行的写入参数快照（例如 { planId, weekIndex, dayIndex, text }）
  forwardData Json @map("forward_data")
  /// 撤销所需快照（例如 { workoutId } 用于 undo PLAN_WORKOUT_ADD）
  reverseData Json @map("reverse_data")

  /// 关联的对话消息块 id（来自 tool_use.id），便于前端把卡片挂在对应消息位置
  messageId String? @map("message_id")
  /// 教练会话 sid，便于按会话过滤「我都帮你做了什么」
  sid       String? @map("sid")

  /// 撤销窗口截止时间（仅 LOW 写入；HIGH 永远为 null）
  undoUntil DateTime? @map("undo_until")
  /// 撤销已执行时间；非空表示已撤销，禁止再次撤销
  undoneAt  DateTime? @map("undone_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, sid, createdAt(sort: Desc)])
  @@map("t_coach_action")
}

/// Immutable materialized public Demo release. Exactly one row may be ACTIVE;
/// the database migration enforces that invariant with a partial unique index.

// User profile table - Stores user body metrics and training parameters
model UserProfile {
  id        String   @id @default(cuid())
