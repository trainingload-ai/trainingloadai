  RUNNING
  COMPLETED
  FAILED
  DEAD
  CANCELLED

  @@map("enum_activity_recompute_job_status")
}

/// 活动地图缩略图任务状态
enum ActivityMapThumbJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD

  @@map("enum_activity_map_thumb_job_status")
}

/// 导入/分析链路事件日志级别
enum ImportEventLevel {
  INFO
  WARN
  ERROR

  @@map("enum_import_event_level")
}

/// 导入管道阶段（用于批次/子任务/后处理的统一事件追踪）
enum ImportPipelineStage {
  BATCH_CREATED
  SOURCE_REGISTERED
  NORMALIZING
  DEDUPING
  MATERIALIZING
  PARQUET_BUILDING
  ANALYZING
  POST_PROCESSING
  NOTIFYING
  COMPLETED
  FAILED

  @@map("enum_import_pipeline_stage")
}

/// AI 教练会话（按用户 + 客户端 sid 唯一；sid 可为 UUID 或历史上的 default）
model AiCoachSession {
  userId      String              @map("user_id")
  id          String              @map("id")
  user        T_user              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        AiCoachSessionType  @default(CHAT) @map("type")
  reviewScope AiCoachReviewScope? @map("review_scope")

  title        String?   @map("title")
  lang         String?   @map("lang")
  summary      String?   @map("summary") @db.Text
  nextSequence Int       @default(1) @map("next_sequence")
  /// 置顶时间；非空表示置顶，列表排在最前（按 pinnedAt 降序）
  pinnedAt     DateTime? @map("pinned_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages             AiCoachMessage[]
  runs                 CoachRun[]
  memoryExtractionJobs AiCoachMemoryExtractionJob[]
  assessmentCases      CoachAssessmentCase[]

  @@id([userId, id])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, type, updatedAt(sort: Desc)])
  @@index([userId, pinnedAt(sort: Desc)])
  @@map("t_ai_coach_session")
}

/// AI 教练单条消息
model AiCoachMessage {
  id String @id @default(cuid())

  userId    String         @map("user_id")
  sessionId String         @map("session_id")
  session   AiCoachSession @relation(fields: [userId, sessionId], references: [userId, id], onDelete: Cascade)

  role     AiCoachMessageRole @map("role")
  content  String             @map("content") @db.Text
  /// Claude Code-style message body. Structured UI/state lives in content blocks, not side-channel payload fields.
  message  Json?              @map("message")
  sequence Int                @map("sequence")

  createdAt DateTime @default(now()) @map("created_at")

  runAttempt           CoachRunAttempt?
  memoryEvidence       AthleteMemoryEvidence[]
  memoryExtractionJobs AiCoachMemoryExtractionJob[]
  assessmentPrompts    CoachAssessmentQuestion[]    @relation("CoachAssessmentPromptMessage")
  assessmentAnswers    CoachAssessmentQuestion[]    @relation("CoachAssessmentAnswerMessage")

  @@unique([userId, sessionId, sequence])
  @@map("t_ai_coach_message")
}

/// 用户级跨对话记忆的当前可查询投影；HealthData 等结构化事实不复制到这里。
model AthleteMemoryFact {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   T_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind            AthleteMemoryKind
  category        String
  claim           String                       @db.Text
  value           Json?
  status          AthleteMemoryStatus          @default(ACTIVE)
  epistemicStatus AthleteMemoryEpistemicStatus @map("epistemic_status")
  confidence      Float

  eventStart        DateTime?                  @map("event_start") @db.Timestamptz(3)
  eventEnd          DateTime?                  @map("event_end") @db.Timestamptz(3)
  timeText          String?                    @map("time_text") @db.Text
  timePrecision     AthleteMemoryTimePrecision @map("time_precision")
  timezone          String
  validFrom         DateTime?                  @map("valid_from") @db.Timestamptz(3)
  validUntil        DateTime?                  @map("valid_until") @db.Timestamptz(3)
  decayProfile      AthleteMemoryDecayProfile  @map("decay_profile")
  relevanceAnchorAt DateTime                   @map("relevance_anchor_at") @db.Timestamptz(3)
  reviewAfter       DateTime?                  @map("review_after") @db.Timestamptz(3)

  supersededById String?             @map("superseded_by_id")
  supersededBy   AthleteMemoryFact?  @relation("AthleteMemorySupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes     AthleteMemoryFact[] @relation("AthleteMemorySupersession")
  version        Int                 @default(1)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  evidence AthleteMemoryEvidence[]
  events   AthleteMemoryEvent[]

  @@index([userId, status, category])
  @@index([userId, eventStart(sort: Desc)])
  @@index([userId, relevanceAnchorAt(sort: Desc)])
  @@index([userId, kind, status])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_memory_fact_user_created")
  @@index([supersededById], map: "idx_memory_fact_superseded_by")
  @@map("t_athlete_memory_fact")
}

/// 原始用户消息只保留引用和哈希；聊天全文仍由 AiCoachMessage 持有。
model AthleteMemoryEvidence {
  id              String                  @id @default(cuid())
  userId          String                  @map("user_id")
  user            T_user                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  factId          String                  @map("fact_id")
  fact            AthleteMemoryFact       @relation(fields: [factId], references: [id], onDelete: Cascade)
  sourceType      AthleteMemorySourceType @map("source_type")
  sourceMessageId String                  @map("source_message_id")
  sourceMessage   AiCoachMessage          @relation(fields: [sourceMessageId], references: [id], onDelete: Cascade)
  assertedAt      DateTime                @map("asserted_at") @db.Timestamptz(3)
  sourceHash      String                  @map("source_hash") @db.Char(64)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  events AthleteMemoryEvent[]

  @@unique([factId, sourceMessageId, sourceHash], map: "uq_memory_evidence_source")
  @@index([userId, sourceMessageId])
  @@map("t_athlete_memory_evidence")
}

/// 不可变的记忆事实演变审计；不保存模型私有推理。
model AthleteMemoryEvent {
  id             String                      @id @default(cuid())
  userId         String                      @map("user_id")
  user           T_user                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  factId         String                      @map("fact_id")
  fact           AthleteMemoryFact           @relation(fields: [factId], references: [id], onDelete: Cascade)
  evidenceId     String?                     @map("evidence_id")
  evidence       AthleteMemoryEvidence?      @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  jobId          String?                     @map("job_id")
  job            AiCoachMemoryExtractionJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  operation      AthleteMemoryEventOperation
  beforeJson     Json?                       @map("before_json")
  afterJson      Json?                       @map("after_json")
  reasonCode     String                      @map("reason_code")
  model          String?
  policyVersion  String                      @map("policy_version")
  idempotencyKey String                      @unique @map("idempotency_key")
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, factId, createdAt])
  @@index([factId], map: "idx_memory_event_fact")
  @@index([jobId], map: "idx_memory_event_job")
  @@map("t_athlete_memory_event")
}

/// AI Coach 用户消息的持久化 Memory Judge 任务。
model AiCoachMemoryExtractionJob {
  id              String                           @id @default(cuid())
  userId          String                           @map("user_id")
  user            T_user                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId       String                           @map("session_id")
  session         AiCoachSession                   @relation(fields: [userId, sessionId], references: [userId, id], onDelete: Cascade)
  sourceMessageId String                           @map("source_message_id")
  sourceMessage   AiCoachMessage                   @relation(fields: [sourceMessageId], references: [id], onDelete: Cascade)
  status          AiCoachMemoryExtractionJobStatus @default(PENDING)
  attempts        Int                              @default(0)
  leaseOwner      String?                          @map("lease_owner")
  leaseExpiresAt  DateTime?                        @map("lease_expires_at") @db.Timestamptz(3)
  model           String?
  policyVersion   String                           @map("policy_version")
  decisionJson    Json?                            @map("decision_json")
  lastError       String?                          @map("last_error") @db.Text
  nextRetryAt     DateTime?                        @map("next_retry_at") @db.Timestamptz(3)
  createdAt       DateTime                         @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt       DateTime?                        @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime?                        @map("finished_at") @db.Timestamptz(3)

  events AthleteMemoryEvent[]

  @@unique([sourceMessageId, policyVersion], map: "uq_memory_job_source_policy")
  @@index([status, nextRetryAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, sessionId], map: "idx_memory_job_session")
  @@map("t_ai_coach_memory_extraction_job")
}

/// 一次不可变、可复现的状态评估。重新评估会新建记录并 supersede 旧记录。
model AthleteStateAssessment {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   T_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  asOf              DateTime                      @map("as_of") @db.Timestamptz(3)
  timezone          String
  state             AthleteStateStatus
  confidence        Float
  decisionReadiness AthleteStateDecisionReadiness @map("decision_readiness")
  evidenceHash      String                        @map("evidence_hash")
  policyVersion     String                        @map("policy_version")
  promptVersion     String                        @map("prompt_version")
  model             String?
  evidenceSnapshot  Json                          @map("evidence_snapshot")
  dimensions        Json
  hypotheses        Json
  evidenceRequests  Json                          @map("evidence_requests")
  safetyFlags       Json                          @map("safety_flags")
  limitations       Json
  latestSourceAt    DateTime?                     @map("latest_source_at") @db.Timestamptz(3)
  expiresAt         DateTime                      @map("expires_at") @db.Timestamptz(3)
  supersededAt      DateTime?                     @map("superseded_at") @db.Timestamptz(3)
  supersededById    String?                       @map("superseded_by_id")
  supersededBy      AthleteStateAssessment?       @relation("AthleteStateSupersede", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes        AthleteStateAssessment[]      @relation("AthleteStateSupersede")
  createdAt         DateTime                      @default(now()) @map("created_at")

  cases CoachAssessmentCase[]

  @@unique([userId, evidenceHash, policyVersion, promptVersion])
  @@index([userId, asOf(sort: Desc)])
  @@index([userId, expiresAt])
  @@index([supersededById])
  @@map("t_athlete_state_assessment")
}

/// 主 Coach 发起的一次动态补证/决策调查。
model CoachAssessmentCase {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   T_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  status        CoachAssessmentCaseStatus @default(OPEN)
  triggerType   String                    @map("trigger_type")
  triggerRef    String?                   @map("trigger_ref")
  asOf          DateTime                  @map("as_of") @db.Timestamptz(3)
  timezone      String
  evidenceHash  String                    @map("evidence_hash")
  dedupeKey     String                    @map("dedupe_key")
  revision      Int                       @default(1)
  questionCount Int                       @default(0) @map("question_count")

  assessmentId String                 @map("assessment_id")
  assessment   AthleteStateAssessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  contextId    String?                @map("context_id")
  context      CoachContext?          @relation(fields: [contextId], references: [id], onDelete: SetNull)
  branchId     String?                @map("branch_id")
  branch       CoachBranch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  decisionId   String?                @map("decision_id")
  decision     CoachDecision?         @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  sessionId    String?                @map("session_id")
  session      AiCoachSession?        @relation(fields: [userId, sessionId], references: [userId, id], onDelete: Cascade)

  planExecutionFactHash String?   @map("plan_execution_fact_hash")
  currentOutcome        Json?     @map("current_outcome")
  cooldownUntil         DateTime? @map("cooldown_until") @db.Timestamptz(3)
  followUpAt            DateTime? @map("follow_up_at") @db.Timestamptz(3)
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(3)
  resolvedAt            DateTime? @map("resolved_at") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  questions CoachAssessmentQuestion[]

  @@index([userId, status, updatedAt(sort: Desc)])
  @@index([userId, dedupeKey])
  @@index([assessmentId])
  @@index([contextId])
  @@index([branchId])
  @@index([decisionId])
  @@index([userId, sessionId])
  @@index([status, followUpAt])
  @@map("t_coach_assessment_case")
}

/// Case 中由服务端创建并精确绑定消息的结构化问题。
model CoachAssessmentQuestion {
  id     String              @id @default(cuid())
  caseId String              @map("case_id")
  case   CoachAssessmentCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  status          CoachAssessmentQuestionStatus @default(PENDING)
  evidenceKind    String                        @map("evidence_kind")
  reason          String                        @db.Text
  decisionImpact  String                        @map("decision_impact") @db.Text
  question        Json
  answer          Json?
  eventStart      DateTime?                     @map("event_start") @db.Timestamptz(3)
  eventEnd        DateTime?                     @map("event_end") @db.Timestamptz(3)
  promptMessageId String?                       @unique @map("prompt_message_id")
  promptMessage   AiCoachMessage?               @relation("CoachAssessmentPromptMessage", fields: [promptMessageId], references: [id], onDelete: SetNull)
  answerMessageId String?                       @unique @map("answer_message_id")
  answerMessage   AiCoachMessage?               @relation("CoachAssessmentAnswerMessage", fields: [answerMessageId], references: [id], onDelete: SetNull)
  askedAt         DateTime?                     @map("asked_at") @db.Timestamptz(3)
  answeredAt      DateTime?                     @map("answered_at") @db.Timestamptz(3)
  expiresAt       DateTime                      @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime                      @default(now()) @map("created_at")

  @@index([caseId, status, createdAt])
  @@index([status, expiresAt])
  @@map("t_coach_assessment_question")
}

/// Logical Coach task; public history is stored once, in AiCoachMessage.
model CoachRun {
  id                 String            @id
  userId             String            @map("user_id")
  sessionId          String            @map("session_id")
  session            AiCoachSession    @relation(fields: [userId, sessionId], references: [userId, id], onDelete: Cascade)
  branchId           String?           @map("branch_id")
  originMessageId    String            @map("origin_message_id")
  taskKind           String            @default("CONVERSATION") @map("task_kind")
  triggerType        String?           @map("trigger_type")
  triggerRef         String?           @map("trigger_ref")
  dedupeKey          String?           @map("dedupe_key")
  inputHash          String?           @map("input_hash")
  resultType         String?           @map("result_type")
  resultRef          Json?             @map("result_ref")
  status             String            @default("running")
  activeAttemptId    String?           @map("active_attempt_id")
  revision           Int               @default(0)
  pendingInteraction Json?             @map("pending_interaction")
  executionMs        Int               @default(0) @map("execution_ms")
  startedAt          DateTime          @default(now()) @map("started_at")
  endedAt            DateTime?         @map("ended_at")
  attempts           CoachRunAttempt[]

  @@unique([userId, taskKind, dedupeKey])
  @@index([userId, sessionId])
  @@index([userId, taskKind, startedAt(sort: Desc)])
  @@map("t_coach_run")
}

/// One request / continuation. Failed attempts are retained rather than replaced.
model CoachRunAttempt {
  id                String         @id
  runId             String         @map("run_id")
  run               CoachRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  userId            String         @map("user_id")
  requestId         String         @map("request_id")
  requestHash       String         @map("request_hash")
  messageId         String         @unique @map("message_id")
  message           AiCoachMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  inputMessageId    String         @map("input_message_id")
  parentAttemptId   String?        @map("parent_attempt_id")
  interactionId     String?        @unique @map("interaction_id")
  submissionId      String?        @map("submission_id")
  answersHash       String?        @map("answers_hash")
  trigger           String
  status            String         @default("running")
  completionReason  String?        @map("completion_reason")
  revision          Int            @default(0)
  operationId       String         @map("operation_id")
  cancelRequestedAt DateTime?      @map("cancel_requested_at")
  ownerId           String         @map("owner_id")
  heartbeatAt       DateTime       @default(now()) @map("heartbeat_at")
  startedAt         DateTime       @default(now()) @map("started_at")
  endedAt           DateTime?      @map("ended_at")
  /// Prevent automatic replay after a side effect; pending IDs also fence recovery.
  mutationStarted   Boolean        @default(false) @map("mutation_started")
  unresolvedTools   Json           @default("[]") @map("unresolved_tools")

  @@unique([userId, requestId])
  @@unique([userId, operationId])
  @@unique([userId, submissionId])
  @@index([runId, startedAt])
  @@index([status, heartbeatAt])
  @@map("t_coach_run_attempt")
}

/// 导入批次任务：承载一次“用户发起的导入请求”，例如批量上传 100 个文件
model ImportBatchJob {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   T_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  sourceKind ImportSourceKind     @map("source_kind")
  status     ImportBatchJobStatus @default(QUEUED) @map("status")

  totalCount   Int @default(0) @map("total_count")
  successCount Int @default(0) @map("success_count")
  failedCount  Int @default(0) @map("failed_count")
  skippedCount Int @default(0) @map("skipped_count")

  requestContext Json? @map("request_context")
  summary        Json? @map("summary")

  startedAt          DateTime? @map("started_at")
  completedAt        DateTime? @map("completed_at")
  notificationSentAt DateTime? @map("notification_sent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items              ImportItemJob[]             @relation("ImportBatchItems")
  createdActivities  Activity[]                  @relation("ActivityCreatedByBatch")
  canonicalSnapshots CanonicalActivitySnapshot[] @relation("BatchCanonicalSnapshots")
  activitySources    ActivitySource[]            @relation("ActivitySourceBatch")
  postProcessJobs    UserPostProcessJob[]        @relation("BatchPostProcessJobs")
  notifications      Notification[]              @relation("NotificationImportBatch")
  eventLogs          ImportEventLog[]            @relation("BatchEventLogs")

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status])
  @@index([status, createdAt(sort: Asc)])
  @@map("t_import_batch_job")
}

/// Garmin 完整导出包的可恢复分片上传会话。

/// 原始输入对象：文件、第三方 API 对象、Webhook 载荷等都以统一 source object 表示
model ImportSourceObject {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   T_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  sourceKind ImportSourceKind    @map("source_kind")
  provider   ThirdPartyProvider? @map("provider")
  sourceUid  String              @map("source_uid")

  accountRef String? @map("account_ref")
  externalId String? @map("external_id")
  objectType String  @default("activity") @map("object_type")

  fileName      String? @map("file_name")
  fileKey       String? @map("file_key")
  rawStorageKey String? @map("raw_storage_key")
  rawChecksum   String? @map("raw_checksum")
  rawPayload    Json?   @map("raw_payload")
  metadata      Json?   @map("metadata")

  /// 查询层使用的活动时间线标题；从远端摘要标准化而来，不代表正式 Activity。
  timelineTitle     String?   @map("timeline_title")
  /// 查询层使用的活动开始时刻；避免活动列表每次从 rawPayload JSON 解析并排序。
  timelineStartTime DateTime? @map("timeline_start_time")

  discoveredAt    DateTime? @map("discovered_at")
  sourceUpdatedAt DateTime? @map("source_updated_at")
  lastSeenAt      DateTime? @map("last_seen_at")

  /// 建议优先向哪个真实来源补数；不是 Activity 身份，也不限制最终解析来源。
  originProvider    ThirdPartyProvider?           @map("origin_provider")
  /// IMPORTABLE 以外的未解析状态可由查询层投影为影子；不会因此创建 Activity。
  resolutionStatus  ImportSourceResolutionStatus  @default(IMPORTABLE) @map("resolution_status")
  resolutionReason  ImportSourceResolutionReason? @map("resolution_reason")
  suggestedProvider ThirdPartyProvider?           @map("suggested_provider")

  /// 非空表示影子已关联到正式 Activity；计算仍只读取该 Activity，不读取来源对象。
  resolvedActivityId Int?      @map("resolved_activity_id")
  resolvedActivity   Activity? @relation("ResolvedImportSourceObjects", fields: [resolvedActivityId], references: [id], onDelete: SetNull)
  resolvedAt         DateTime? @map("resolved_at")

  originSyncRequestId String?                    @map("origin_sync_request_id")
  originSyncRequest   OriginActivitySyncRequest? @relation(fields: [originSyncRequestId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  itemJobs                ImportItemJob[]
  canonicalSnapshots      CanonicalActivitySnapshot[]
