  title       String
  description String?
  goal        String?
  periodWeeks Int         @map("period_weeks")
  sportTypes  SportType[] @map("sport_types")

  workoutCount        Int    @map("workout_count")
  trainingDaysPerWeek Int?   @map("training_days_per_week")
  locale              String @default("en")

  payloadHash    String @map("payload_hash")
  payloadVersion String @map("payload_version")
  payload        Json
  payloadBytes   Int    @map("payload_bytes")

  revokedAt DateTime? @map("revoked_at")

  @@unique([lineageId, version])
  @@index([sourcePlanId])
