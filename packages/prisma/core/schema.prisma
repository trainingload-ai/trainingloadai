// User subscription list

// 训练计划表 - 存储User的训练计划（一个计划包含多个具体的 workout）
model Plan {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   T_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?
  goal        String?

  sourceType         PlanSourceType @default(MANUAL) @map("source_type")
  status             PlanStatus     @default(DRAFT)
  generationMetadata Json?          @map("generation_metadata")

  periodWeeks Int @map("period_weeks")

  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  activatedAt  DateTime? @map("activated_at")
  pausedAt     DateTime? @map("paused_at")
  completedAt  DateTime? @map("completed_at")
  cancelledAt  DateTime? @map("cancelled_at")
  supersededAt DateTime? @map("superseded_at")

  /// 新计划指向它所替代的旧计划；唯一约束保证一个旧计划最多只有一个待接管/已接管后继。
  supersedesPlanId String? @unique @map("supersedes_plan_id")
  supersedes       Plan?   @relation("PlanSupersession", fields: [supersedesPlanId], references: [id], onDelete: SetNull)
  supersededBy     Plan?   @relation("PlanSupersession")

  scheduledActivationAt DateTime? @map("scheduled_activation_at")
  activationTimezone    String?   @map("activation_timezone")
  activationBlockedAt   DateTime? @map("activation_blocked_at")
  activationBlockReason String?   @map("activation_block_reason")

  currentWeekIndex Int? @map("current_week_index")
  currentDayIndex  Int? @map("current_day_index")

  derivedFromShareId   String? @map("derived_from_share_id")
  derivedFromLineageId String? @map("derived_from_lineage_id")
  rootLineageId        String? @map("root_lineage_id")

  workouts            PlanWorkout[]
  links               PlanWorkoutActivityLink[]
  coachContext        CoachContext?
  coachSummary        CoachSummary?
  shareVersions       PlanShare[]
  templatePreview     PlanTemplatePreview?
  proposalPreviews    PlanProposalPreview[]     @relation("PlanProposalSource")
  createdFromProposal PlanProposalPreview?      @relation("PlanProposalCreatedPlan")

  @@index([derivedFromShareId])
  @@index([derivedFromLineageId])
  @@index([userId, status])
  @@index([userId, updatedAt])
  @@index([status, startDate])
  @@index([userId, status, scheduledActivationAt])
  @@index([supersedesPlanId])
  @@map("t_plan")
}

/// 用户确认前的服务端规范化计划提案。提案不可由模型在确认阶段改写，且短期过期。
model PlanProposalPreview {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   T_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  mode PlanProposalMode

  sourcePlanId String @map("source_plan_id")
  sourcePlan   Plan   @relation("PlanProposalSource", fields: [sourcePlanId], references: [id], onDelete: Cascade)

  request        Json
  sourceSnapshot Json @map("source_snapshot")
  proposal       Json
  presentation   Json

  expiresAt DateTime  @map("expires_at")
  appliedAt DateTime? @map("applied_at")

  decisionId        String?        @unique @map("decision_id")
  decision          CoachDecision? @relation("PlanProposalDecision", fields: [decisionId], references: [id], onDelete: SetNull)
  appliedDecisionId String?        @unique @map("applied_decision_id")
  createdPlanId     String?        @unique @map("created_plan_id")
  createdPlan       Plan?          @relation("PlanProposalCreatedPlan", fields: [createdPlanId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@index([sourcePlanId, expiresAt])
  @@index([expiresAt, appliedAt])
  @@map("t_plan_proposal_preview")
}

/// One-time, short-lived bridge from the public VDOT generator to an authenticated plan draft.
model PlanImportDraft {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tokenHash String   @unique @map("token_hash")
  payload   Json
  expiresAt DateTime @map("expires_at")

  consumedAt       DateTime? @map("consumed_at")
  consumedByUserId String?   @map("consumed_by_user_id")

  @@index([expiresAt])
  @@map("t_plan_import_draft")
}

/// User-bound, short-lived snapshot for deterministic official plan-template creation.
model PlanTemplatePreview {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   T_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash           String   @unique @map("token_hash")
  templateKey         String   @map("template_key")
  templateVersion     String   @map("template_version")
  templateContentHash String   @map("template_content_hash")
  variantId           String   @map("variant_id")
  locale              String
  normalizedInput     Json     @map("normalized_input")
  payload             Json
  expiresAt           DateTime @map("expires_at")

  consumedAt    DateTime? @map("consumed_at")
  createdPlanId String?   @unique @map("created_plan_id")
  createdPlan   Plan?     @relation(fields: [createdPlanId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("t_plan_template_preview")
}

model PlanShareLineage {
