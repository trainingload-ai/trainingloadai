model SportDefinition {
  code        String    @id
  family      SportType
  displayName String    @map("display_name")
  description String?

  zoneFamily                  SportType?            @map("zone_family")
  paceBasisMeters             Int?                  @map("pace_basis_meters")
  cadenceUnit                 SportCadenceUnit?     @map("cadence_unit")
  defaultWorkoutStructureKind WorkoutStructureKind? @map("default_workout_structure_kind")
  fitSport                    String?               @map("fit_sport")
  fitSubSport                 String?               @map("fit_sub_sport")
  isDefaultForFamily          Boolean               @default(false) @map("is_default_for_family")

  supportsPlanning          Boolean @default(false) @map("supports_planning")
  supportsStructuredWorkout Boolean @default(false) @map("supports_structured_workout")
  supportsDistance          Boolean @default(false) @map("supports_distance")
  supportsPace              Boolean @default(false) @map("supports_pace")
  supportsSpeed             Boolean @default(false) @map("supports_speed")
  supportsPower             Boolean @default(false) @map("supports_power")
  supportsCadence           Boolean @default(false) @map("supports_cadence")

  sortOrder Int     @default(0) @map("sort_order")
  active    Boolean @default(true)
  metadata  Json?

  providerMappings  ProviderSportMapping[]
  activities        Activity[]
  planWorkouts      PlanWorkout[]
  competitionEvents CompetitionEvent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([family, active, sortOrder])
  @@index([supportsPlanning, active, sortOrder])
  @@map("t_sport_definition")
}

model ProviderSportMapping {
  id String @id @default(cuid())

  provider        ThirdPartyProvider
  externalCode    String                        @map("external_code")
  externalSubCode String                        @default("") @map("external_sub_code")
  direction       ProviderSportMappingDirection @default(BOTH)
  priority        Int                           @default(0)

  sportCode String          @map("sport_code")
  sport     SportDefinition @relation(fields: [sportCode], references: [code], onDelete: Cascade)

  metadata Json?
  active   Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([provider, externalCode, externalSubCode, direction])
  @@index([provider, sportCode, direction, active])
  @@map("t_provider_sport_mapping")
}

