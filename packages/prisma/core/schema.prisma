/// Durable singleton for self-host ownership and repeatable local reinitialization.
/// The database stores only a SHA-256 digest of the high-entropy bootstrap token.
model SelfHostInstance {
  id                            Int                         @id @default(1)
  state                         SelfHostInitializationState @default(PENDING)
  bootstrapTokenHash            String?                     @map("bootstrap_token_hash")
  bootstrapTokenExpiresAt       DateTime?                   @map("bootstrap_token_expires_at")
  ownerUserId                   String?                     @unique @map("owner_user_id")
  owner                         T_user?                     @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  /// Null means "use the signed deployment configuration". A non-null value
  /// is an owner-managed override created from the self-host settings UI.
  aiProvider                    String?                     @map("ai_provider")
  aiBaseUrl                     String?                     @map("ai_base_url")
  aiDefaultModel                String?                     @map("ai_default_model")
  aiDefaultModelContextTokens   Int?                        @map("ai_default_model_context_tokens")
  aiReasoningModel              String?                     @map("ai_reasoning_model")
  aiReasoningModelContextTokens Int?                        @map("ai_reasoning_model_context_tokens")
  aiWebSearchEnabled            Boolean                     @default(false) @map("ai_web_search_enabled")
  /// AES-256-GCM envelope. The plaintext provider key is never returned by an API.
  aiApiKeyEncrypted             String?                     @map("ai_api_key_encrypted") @db.Text
  aiConfigUpdatedAt             DateTime?                   @map("ai_config_updated_at")
  /// Explicit owner opt-in for browser-side product operation counters.
  /// Event payloads must not include training, account, route, or AI content.
  telemetryConsentGranted       Boolean?                    @map("telemetry_consent_granted")
  telemetryConsentVersion       String?                     @map("telemetry_consent_version")
  telemetryConsentSource        String?                     @map("telemetry_consent_source")
  telemetryConsentUpdatedAt     DateTime?                   @map("telemetry_consent_updated_at")
  initializedAt                 DateTime?                   @map("initialized_at")
  createdAt                     DateTime                    @default(now()) @map("created_at")
  updatedAt                     DateTime                    @updatedAt @map("updated_at")

  @@map("t_self_host_instance")
}

/// 用户长期赛事时间线。赛事独立于训练计划，不保存 planId 或 planWorkoutId。
model CompetitionEvent {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   T_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  title               String
  sportType           SportType        @map("sport_type")
  sportDefinitionCode String?          @map("sport_definition_code")
  sportDefinition     SportDefinition? @relation(fields: [sportDefinitionCode], references: [code], onDelete: SetNull)
  distanceMeters      Float?           @map("distance_meters")

  startDate       DateTime  @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  startTimeMinute Int?      @map("start_time_minute")
  timezone        String?

  importance        CompetitionImportance @default(HIGH)
  goalType          CompetitionGoalType   @map("goal_type")
  targetTimeSeconds Int?                  @map("target_time_seconds")

  location String?
  notes    String?                @db.Text
  status   CompetitionStatus      @default(PLANNED)
  source   CompetitionEventSource @default(MANUAL)

  /// 仅用于 POST 创建幂等；不返回客户端。
  idempotencyKey  String?   @map("idempotency_key")
  idempotencyHash String?   @map("idempotency_hash")
  version         Int       @default(1)
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  revisions CompetitionEventRevision[]

  @@unique([userId, idempotencyKey])
  @@index([userId, startDate])
  @@index([userId, status, startDate])
  @@index([userId, deletedAt, startDate])
  @@index([sportDefinitionCode])
  @@map("t_competition_event")
}

