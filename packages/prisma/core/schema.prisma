// 计划训练「期望负荷」的主导轨道
// - POWER: 该课主导步骤为 POWER target，IF = midPower / FTP
// - HR:    HEART_RATE target，IF = midHR / LTHR
// - PACE:  SPEED target，IF = threshold_pace / step_pace（跑用 TP，游用 CSS）
// - RPE:   全部 OPEN/CADENCE/GRADE 兜底为 intensity 常量
// - NONE:  阈值缺失或无可估算步骤
enum PlanLoadSource {
  POWER
  HR
  PACE
  RPE
  SESSION_RPE
  NONE

  @@map("enum_plan_load_source")
}

// 训练计划 step 类型
// - WORK: 正常训练步骤
// - REST: 恢复/休息步骤
// - REPEAT: 重复容器，本身不执行，子步骤按 repeat 规则重复
enum WorkoutPlanStepType {
  WORK
  REST
  REPEAT

  @@map("enum_plan_workout_step_type")
}

// 训练步骤强度标签
// 对应 FIT workout step 的 intensity 概念，用于表达热身、冷身、恢复等语义
enum WorkoutPlanStepIntensity {
  ACTIVE
  REST
  WARMUP
  COOLDOWN
  RECOVERY
  INTERVAL
  OTHER

  @@map("enum_plan_workout_step_intensity")
}

// 训练步骤的“结束条件 / 持续条件”
// 对应 FIT workout step 的 duration type
// 例如：
// - TIME: 按时间结束
// - DISTANCE: 按距离结束
// - OPEN: 开放步骤，无明确结束条件
// - HR/POWER/CADENCE_*: 达到某个阈值时结束
// - REPEAT_*: repeat 容器的重复规则
enum WorkoutPlanStepDurationType {
  TIME
  DISTANCE
  OPEN
  CALORIES
  HR_LESS_THAN
  HR_GREATER_THAN
  POWER_LESS_THAN
  POWER_GREATER_THAN
  CADENCE_LESS_THAN
  CADENCE_GREATER_THAN
  REPEAT_COUNT
  REPEAT_UNTIL_TIME
  REPEAT_UNTIL_DISTANCE
  REPEAT_UNTIL_CALORIES
  REPEAT_UNTIL_HR_LESS_THAN
  REPEAT_UNTIL_HR_GREATER_THAN
  REPEAT_UNTIL_POWER_LESS_THAN
  REPEAT_UNTIL_POWER_GREATER_THAN
  REPEAT_UNTIL_CADENCE_LESS_THAN
  REPEAT_UNTIL_CADENCE_GREATER_THAN

  @@map("enum_plan_workout_step_duration_type")
}

// 训练步骤的目标类型
// 对应 FIT workout step 的 target type
// 例如功率、心率、踏频、速度、坡度，或 OPEN（无目标）
enum WorkoutPlanStepTargetType {
  OPEN
  POWER
  HEART_RATE
  CADENCE
  SPEED
  GRADE

  @@map("enum_plan_workout_step_target_type")
}

