{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainingload.ai/schemas/self-host-doctor-report-v1.json",
  "title": "Trainingload self-host doctor report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "generatedAt",
    "releaseVersion",
    "mode",
    "overall",
    "counts",
    "checks"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "trainingload-selfhost-doctor-report" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "releaseVersion": { "type": "string", "minLength": 1 },
    "mode": {
      "enum": ["core-local", "connected", "extended", "unknown"]
    },
    "overall": { "enum": ["pass", "warning", "fail"] },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "warning", "fail", "skipped"],
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "warning": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "category",
        "status",
        "summary",
        "errorCode",
        "remediation",
        "details"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^SELF_HOST_DOCTOR_[A-Z0-9_]+$"
        },
        "category": {
          "enum": [
            "release",
            "host",
            "configuration",
            "security",
            "runtime",
            "storage",
            "database",
            "capability",
            "recovery"
          ]
        },
        "status": { "enum": ["pass", "warning", "fail", "skipped"] },
        "summary": { "type": "string", "minLength": 1 },
        "errorCode": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "pattern": "^SELF_HOST_[A-Z0-9_]+$"
            }
          ]
        },
        "remediation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "documentation"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "documentation": {
              "type": "string",
              "pattern": "^docs/self-hosting/[a-z0-9./#-]+\\.zh\\.md(#[a-z0-9-]+)?$"
            }
          }
        },
        "details": { "type": "object" }
      }
    }
  }
}
