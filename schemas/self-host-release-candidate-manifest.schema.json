{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainingload.ai/schemas/self-host-release-candidate-manifest-v1.json",
  "title": "Trainingload self-host release candidate manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "candidateId",
    "generatedAt",
    "status",
    "workflow",
    "release",
    "acceptance",
    "attestations",
    "compatibility",
    "documents",
    "contracts",
    "summary"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "trainingload-selfhost-release-candidate" },
    "candidateId": { "type": "string", "pattern": "^rc\\.[1-9][0-9]*$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "const": "candidate" },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "revision", "ref"],
      "properties": {
        "runId": { "$ref": "#/$defs/runId" },
        "revision": { "$ref": "#/$defs/revision" },
        "ref": { "$ref": "#/$defs/workflowRef" }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "revision",
        "workflowRunId",
        "archive",
        "archiveSha256",
        "checksum",
        "signatureBundle",
        "releaseManifest",
        "releaseManifestSha256",
        "bundleManifest",
        "bundleManifestSha256"
      ],
      "properties": {
        "version": { "$ref": "#/$defs/version" },
        "revision": { "$ref": "#/$defs/revision" },
        "workflowRunId": { "$ref": "#/$defs/runId" },
        "archive": {
          "type": "string",
          "pattern": "^release/trainingload-selfhost-[A-Za-z0-9.-]+\\.tar\\.gz$"
        },
        "archiveSha256": { "$ref": "#/$defs/sha256" },
        "checksum": {
          "type": "string",
          "pattern": "^release/[A-Za-z0-9.-]+\\.tar\\.gz\\.sha256$"
        },
        "signatureBundle": {
          "type": "string",
          "pattern": "^release/[A-Za-z0-9.-]+\\.tar\\.gz\\.sha256\\.bundle\\.json$"
        },
        "releaseManifest": { "const": "release/release-manifest.json" },
        "releaseManifestSha256": { "$ref": "#/$defs/sha256" },
        "bundleManifest": { "const": "release/bundle-manifest.json" },
        "bundleManifestSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflowRunId",
        "workflowRunAttempt",
        "manifest",
        "manifestSha256",
        "checksums",
        "signatureBundle",
        "requiredCells",
        "passedCells",
        "scenarioExecutions",
        "securityChecks"
      ],
      "properties": {
        "workflowRunId": { "$ref": "#/$defs/runId" },
        "workflowRunAttempt": { "type": "integer", "minimum": 1 },
        "manifest": { "const": "acceptance/acceptance-manifest.json" },
        "manifestSha256": { "$ref": "#/$defs/sha256" },
        "checksums": { "const": "acceptance/acceptance-checksums.txt" },
        "signatureBundle": {
          "const": "acceptance/acceptance-checksums.bundle.json"
        },
        "requiredCells": { "type": "integer", "minimum": 1 },
        "passedCells": { "type": "integer", "minimum": 1 },
        "scenarioExecutions": { "type": "integer", "minimum": 1 },
        "securityChecks": { "type": "integer", "minimum": 1 }
      }
    },
    "attestations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "codexCleanRoom", "issueReview"],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "const": "attestations/release-attestation.json" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "codexCleanRoom": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "evidenceSha256",
            "reference",
            "platform",
            "architecture",
            "dockerVersion",
            "composeVersion",
            "dockerOperatingSystem",
            "contractSource",
            "cleanTarget",
            "installerDryRunPassed",
            "installationCompleted",
            "deploymentReady",
            "ownerBootstrapPerformedByOperator",
            "coreUserJourneyPassed",
            "containerRecreatePassed",
            "hostRestartPassed",
            "postRestartDataVerified",
            "diagnosticsReviewed",
            "secretScan"
          ],
          "properties": {
            "status": { "const": "passed" },
            "evidenceSha256": { "$ref": "#/$defs/sha256" },
            "reference": { "$ref": "#/$defs/evidenceReference" },
            "platform": {
              "enum": [
                "ubuntu-amd64",
                "linux-arm64",
                "macos-apple-silicon",
                "windows-11-wsl2"
              ]
            },
            "architecture": { "enum": ["amd64", "arm64"] },
            "dockerVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "composeVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "dockerOperatingSystem": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "contractSource": { "const": "signed-release-bundle-only" },
            "cleanTarget": { "const": true },
            "installerDryRunPassed": { "const": true },
            "installationCompleted": { "const": true },
            "deploymentReady": { "const": true },
            "ownerBootstrapPerformedByOperator": { "const": true },
            "coreUserJourneyPassed": { "const": true },
            "containerRecreatePassed": { "const": true },
            "hostRestartPassed": { "const": true },
            "postRestartDataVerified": { "const": true },
            "diagnosticsReviewed": { "const": true },
            "secretScan": { "const": "pass" }
          }
        },
        "issueReview": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "unresolvedP0",
            "unresolvedP1",
            "releaseBlockers",
            "knownLimitationsReviewed",
            "evidenceSha256",
            "reference"
          ],
          "properties": {
            "status": { "const": "passed" },
            "unresolvedP0": { "const": 0 },
            "unresolvedP1": { "const": 0 },
            "releaseBlockers": { "const": 0 },
            "knownLimitationsReviewed": { "const": true },
            "evidenceSha256": { "$ref": "#/$defs/sha256" },
            "reference": { "$ref": "#/$defs/evidenceReference" }
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v1ContractSchemaVersion",
        "configSchemaVersion",
        "composeSchemaVersion",
        "releaseBundleSchemaVersion",
        "databaseSchemaEpoch",
        "migrationHead",
        "compatibilityWindowMinorVersions",
        "supportedSourceVersions",
        "applicationRollbackTo",
        "databaseRollback"
      ],
      "properties": {
        "v1ContractSchemaVersion": { "const": 1 },
        "configSchemaVersion": { "type": "integer", "minimum": 1 },
        "composeSchemaVersion": { "type": "integer", "minimum": 1 },
        "releaseBundleSchemaVersion": { "type": "integer", "minimum": 1 },
        "databaseSchemaEpoch": { "type": "integer", "minimum": 1 },
        "migrationHead": { "type": "string", "minLength": 1 },
        "compatibilityWindowMinorVersions": { "type": "integer", "minimum": 2 },
        "supportedSourceVersions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/version" }
        },
        "applicationRollbackTo": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/version" }
        },
        "databaseRollback": { "const": "unsupported" }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/file" }
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/file" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseSignaturesVerified",
        "acceptanceSignatureVerified",
        "allMatrixCellsPassed",
        "structuredAttestationVerified",
        "codexCleanRoomPassed",
        "hostRestartVerified",
        "unresolvedP0",
        "unresolvedP1",
        "releaseBlockers"
      ],
      "properties": {
        "releaseSignaturesVerified": { "const": true },
        "acceptanceSignatureVerified": { "const": true },
        "allMatrixCellsPassed": { "const": true },
        "structuredAttestationVerified": { "const": true },
        "codexCleanRoomPassed": { "const": true },
        "hostRestartVerified": { "const": true },
        "unresolvedP0": { "const": 0 },
        "unresolvedP1": { "const": 0 },
        "releaseBlockers": { "const": 0 }
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "runId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
    "workflowRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[^\\r\\n]+$"
    },
    "evidenceReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?:https|codex)://[^\\s]+$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?:documents|contracts)/[A-Za-z0-9._/-]+$"
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
