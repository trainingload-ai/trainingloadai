# Copy this file to .env.selfhost. Never commit the resulting file.
# Generate all three secrets with: openssl rand -hex 32
SELF_HOST_AUTH_SECRET=replace-with-64-hex-characters
SELF_HOST_DATABASE_PASSWORD=replace-with-64-hex-characters
# Encrypts per-user integration credentials in PostgreSQL. This is generated
# instance key material, not an Intervals.icu API key.
SELF_HOST_INTEGRATION_SECRET=replace-with-64-hex-characters

# Stable Docker Compose namespace for this instance. Use a different value for
# a clean restore or a second isolated instance on the same Docker Engine.
SELF_HOST_PROJECT_NAME=trainingload-selfhost

# Browser origin and the only published Client port.
SELF_HOST_SITE_ADDRESS=http://localhost:43210
SELF_HOST_HTTP_BIND=127.0.0.1
SELF_HOST_HTTP_PORT=43210
# The default passwordless single-owner flow is for local access.
# For remote access use an SSH tunnel or an authenticated external reverse proxy.
# SELF_HOST_DATA_ROOT=./data
# Bootstrap token TTL is 600-604800 seconds.
# SELF_HOST_BOOTSTRAP_TOKEN_TTL_SECONDS=86400

# Immutable release references are preferred. The source-build override uses
# these names as local build targets and never publishes them.
SELF_HOST_SERVER_IMAGE=trainingload-selfhost-server:1.1.14
SELF_HOST_MIGRATE_IMAGE=trainingload-selfhost-migrate:1.1.14
SELF_HOST_CLIENT_IMAGE=trainingload-selfhost-client:1.1.14
SELF_HOST_VERSION=1.1.14


# Optional, stable non-secret settings.
SELF_HOST_MODE=core-local
SELF_HOST_DATABASE_NAME=trainingload
SELF_HOST_DATABASE_USER=trainingload
# The Server owns two Prisma pools (application and auth). Five connections per
# pool keeps a single-owner instance well below PostgreSQL's default limit.
SELF_HOST_DATABASE_CONNECTION_LIMIT=5
SELF_HOST_DATABASE_POOL_TIMEOUT_SECONDS=20
# Core Local keeps the map provider disabled and makes no map requests. For a connected
# instance, set SELF_HOST_MODE=connected and MAP_PROVIDER=openfreemap to use the
# public OpenFreeMap vector style without an API key.
MAP_PROVIDER=none
MAP_STYLE_URL=
MAP_TILE_URL=
MAP_ATTRIBUTION=
# Signed v1 policy marker. Telemetry is fixed off across server and client.
TELEMETRY_ENABLED=false

# AI is disabled by default. Recommended: claim the owner account, then configure
# the provider in Client -> Settings -> Self-hosted AI. The values below are a
# deployment-level fallback for unattended provisioning; uncomment one complete
# provider group only. An OpenAI API key is separate from a ChatGPT subscription.
# AI_PROVIDER=openai
# OPENAI_API_KEY=replace-with-provider-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_DEFAULT_MODEL=replace-with-default-model-id
# OPENAI_REASONING_MODEL=replace-with-reasoning-model-id
#
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=replace-with-provider-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_DEFAULT_MODEL=deepseek-flash
# DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
#
# AI_PROVIDER=custom-openai-compatible
# AI_API_KEY=replace-with-provider-api-key
# AI_BASE_URL=http://llm.example.local/v1
# AI_DEFAULT_MODEL=replace-with-default-model-id
# AI_REASONING_MODEL=replace-with-reasoning-model-id
